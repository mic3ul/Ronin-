# Ronin configuration
BOT_TOKEN=your_bot_token_here
BOT_OWNER=123456789
BOT_LOCALE=ru

# Group IDs (comma-separated for multiple groups)
GROUPS_MAIN=-1001234567890,-1001234567891
GROUPS_REPORTS=-1001234567892
GROUPS_LOGS=-1001234567893
LINKED_CHANNELS=-1001234567894,-1001234567895

# Durable database URL (SQLite is suitable only for a persistent local volume)
DB_URL=sqlite+aiosqlite:///db.sqlite

# Optional Cloudflare webhook mode (run: python webhook.py)
# TELEGRAM_WEBHOOK_URL=https://<worker-name>.<account-subdomain>.workers.dev
# WEBHOOK_SECRET=generate-a-random-secret
# WEBHOOK_PATH=/telegram/webhook
# PORT=8080
